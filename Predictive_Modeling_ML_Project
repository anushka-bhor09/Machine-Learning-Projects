call, f1\n","\n","\n","# Evaluate all three models\n","\n","logistic_accuracy, logistic_precision, logistic_recall, logistic_f1 = evaluate_model(\n","    y_test,\n","    logistic_predictions\n",")\n","\n","dt_accuracy, dt_precision, dt_recall, dt_f1 = evaluate_model(\n","    y_test,\n","    dt_predictions\n",")\n","\n","rf_accuracy, rf_precision, rf_recall, rf_f1 = evaluate_model(\n","    y_test,\n","    rf_predictions\n",")\n","\n","# ------------------------------------------\n","# 7. Model Comparison Table\n","# ------------------------------------------\n","\n","results = pd.DataFrame({\n","\n","    \"Model\": [\n","        \"Logistic Regression\",\n","        \"Decision Tree\",\n","        \"Random Forest\"\n","    ],\n","\n","    \"Accuracy\": [\n","        logistic_accuracy,\n","        dt_accuracy,\n","        rf_accuracy\n","    ],\n","\n","    \"Precision\": [\n","        logistic_precision,\n","        dt_precision,\n","        rf_precision\n","    ],\n","\n","    \"Recall\": [\n","        logistic_recall,\n","        dt_recall,\n","        rf_recall\n","    ],\n","\n","    \"F1 Score\": [\n","        logistic_f1,\n","        dt_f1,\n","        rf_f1\n","    ]\n","})\n","\n","print(\"\\nMODEL PERFORMANCE\")\n","display(results)\n","\n","# ------------------------------------------\n","# 8. Accuracy Visualization\n","# ------------------------------------------\n","\n","plt.figure(figsize=(8,5))\n","\n","sns.barplot(\n","    data=results,\n","    x=\"Model\",\n","    y=\"Accuracy\"\n",")\n","\n","plt.title(\"Model Accuracy Comparison\")\n","plt.xlabel(\"Machine Learning Model\")\n","plt.ylabel(\"Accuracy\")\n","\n","plt.ylim(0, 1)\n","plt.xticks(rotation=15)\n","\n","plt.show()\n","\n","# ------------------------------------------\n","# 9. Confusion Matrix - Logistic Regression\n","# ------------------------------------------\n","\n","cm = confusion_matrix(\n","    y_test,\n","    logistic_predictions\n",")\n","\n","ConfusionMatrixDisplay(\n","    confusion_matrix=cm,\n","    display_labels=[\"Fail\", \"Pass\"]\n",").plot()\n","\n","plt.title(\"Confusion Matrix - Logistic Regression\")\n","plt.show()\n","\n","# ------------------------------------------\n","# 10. Confusion Matrix - Decision Tree\n","# ------------------------------------------\n","\n","cm = confusion_matrix(\n","    y_test,\n","    dt_predictions\n",")\n","\n","ConfusionMatrixDisplay(\n","    confusion_matrix=cm,\n","    display_labels=[\"Fail\", \"Pass\"]\n",").plot()\n","\n","plt.title(\"Confusion Matrix - Decision Tree\")\n","plt.show()\n","\n","# ------------------------------------------\n","# 11. Confusion Matrix - Random Forest\n","# ------------------------------------------\n","\n","cm = confusion_matrix(\n","    y_test,\n","    rf_predictions\n",")\n","\n","ConfusionMatrixDisplay(\n","    confusion_matrix=cm,\n","    display_labels=[\"Fail\", \"Pass\"]\n",").plot()\n","\n","plt.title(\"Confusion Matrix - Random Forest\")\n","plt.show()\n","\n","# ------------------------------------------\n","# 12. ROC Curve and AUC\n","# ------------------------------------------\n","\n","logistic_prob = logistic_model.predict_proba(X_test)[:, 1]\n","\n","dt_prob = dt_model.predict_proba(X_test)[:, 1]\n","\n","rf_prob = rf_model.predict_proba(X_test)[:, 1]\n","\n","logistic_auc = roc_auc_score(\n","    y_test,\n","    logistic_prob\n",")\n","\n","dt_auc = roc_auc_score(\n","    y_test,\n","    dt_prob\n",")\n","\n","rf_auc = roc_auc_score(\n","    y_test,\n","    rf_prob\n",")\n","\n","print(\"\\nAUC SCORES\")\n","print(\"Logistic Regression:\", logistic_auc)\n","print(\"Decision Tree:\", dt_auc)\n","print(\"Random Forest:\", rf_auc)\n","\n","# ------------------------------------------\n","# 13. ROC Curves\n","# ------------------------------------------\n","\n","logistic_fpr, logistic_tpr, _ = roc_curve(\n","    y_test,\n","    logistic_prob\n",")\n","\n","dt_fpr, dt_tpr, _ = roc_curve(\n","    y_test,\n","    dt_prob\n",")\n","\n","rf_fpr, rf_tpr, _ = r